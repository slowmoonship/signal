{
  "// ": "测试与配置文件单独做类型检查：它们不属于任何 package 的 build 产物",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@slowmoonship/metrics": ["./packages/metrics/src/index.ts"],
      // 与 apps/web/tsconfig.json 的 '@/*' 指向同处：web 侧的测试会顺着 import
      // 把 src/app 下的路由文件一并拉进这次检查，路径映射必须在这里也能解析，
      // 否则报出来的 TS2307 会让人以为页面本身引不到自己的模块。
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "packages/*/test/**/*.ts",
    "apps/web/test/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
